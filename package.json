{
  "name": "clawd-pumpany",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "backend:dev": "npm run dev --workspace=apps/backend",
    "frontend:dev": "npm run dev --workspace=apps/frontend",
    "contracts:deploy": "npm run deploy --workspace=packages/contracts"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
